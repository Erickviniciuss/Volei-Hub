{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Abrir login.html diretamente no Chrome",
            "file": "${workspaceFolder}/login.html"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Abrir index.html diretamente no Chrome",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Live Server (http://localhost:5500)",
            "url": "http://localhost:5500/login.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}